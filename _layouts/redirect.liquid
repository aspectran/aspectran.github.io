---
# This layout is used to redirect pages, if you moved them.
# Use the following settings in front matter:
#
# layout: redirect
# sitemap: false
# permalink: /old-location/
# redirect_to: /new-location/
#
# If you need to detect the language of the page, use the following setting:
# lang_detect: true
#
# Idea and Code by: http://codingtips.kanishkkunal.in/about/
---
<!DOCTYPE html>
<html lang="{% if page.lang == nil %}{{ site.default_lang }}{% else %}{{ page.lang }}{% endif %}">
<head>
  <meta http-equiv="content-type" content="text/html; charset=utf-8"/>
  <title>Redirecting...</title>
{% if page.lang_detect == true %}
  {% include lang-detect.liquid permalink=page.permalink %}
{% else %}
  <link rel="canonical" href="{{ site.url }}{{ page.redirect_to }}"/>
  <meta http-equiv="refresh" content="0;url={{ page.redirect_to }}"/>
{% endif %}
  <style>
    body {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100vh;
      background-color: #353b3e;
      color: #8599a2;
    }
    a, a:hover, a:visited {
      color: #21738c;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <div>
    <h1>Redirecting...</h1>
    {{ site.data.messages[page.lang].if_you_are_not_redirected_automatically }} <a href="{{ page.redirect_to }}">{{ site.data.messages[page.lang].click_here }}</a>.
    <script>location.href = "{{ page.redirect_to }}";</script>
  </div>
</body>
</html>
